# ─── API HTTP ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Token obrigatório para /api/security/*. Gere com:
#   openssl rand -hex 32
NEON_API_TOKEN=

# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:3000

# Endpoint de execução de comandos. Desligado por padrão.
# Só ligue se souber exatamente o que está fazendo.
ENABLE_TERMINAL=false

# ─── Banco de dados ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Watchdog de rede ────────────────────────────────────────
WIFI_INTERFACE=wlx90916470a8ff
WATCHDOG_INTERVAL=10
# Desconexão automática da rede ao detectar ameaça. Padrão: desligado.
AUTO_LOCKDOWN=false

# ─── Monitor de IA ───────────────────────────────────────────
AI_MONITOR_INTERVAL=5

# ─── Interceptador IMAP ──────────────────────────────────────
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=
EMAIL_PASS=
PATROL_INTERVAL=1800
# Ação ao detectar ameaça: relatorio | quarentena | excluir
# "relatorio" (padrão) apenas registra, não toca nas mensagens.
INTERCEPTOR_ACAO=relatorio
INTERCEPTOR_PASTA_QUARENTENA=Neon/Quarentena
# Pontuação mínima para considerar uma mensagem como ameaça (1-10).
INTERCEPTOR_LIMIAR=4

HOST=127.0.0.1
